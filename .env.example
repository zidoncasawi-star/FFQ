# ==============================================================================
# QB Gig Finder - Environment Configuration
# ==============================================================================

# Database Connection
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (e.g. Supabase, Vercel Postgres, Neon):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres?sslmode=require"
# DATABASE_URL="postgres://default:[PASSWORD]@[HOST].postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# NextAuth.js Configuration
# ------------------------------------------------------------------------------
# Run `openssl rand -base64 32` to generate a strong random secret
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# Admin Initial Seed Credentials
# ------------------------------------------------------------------------------
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="QBAdminSecurePassword2026!"

# Contact Form Destination
# ------------------------------------------------------------------------------
CONTACT_EMAIL_TO="contact@example.com"

# Optional Scraping Proxy / ScraperAPI (for automated Cloudflare/PerimeterX bypass)
# ------------------------------------------------------------------------------
# Get a free key at https://www.scraperapi.com to bypass datacenter IP blocks automatically
SCRAPER_API_KEY=""

# Platform / AI Studio Runtime Variables
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

